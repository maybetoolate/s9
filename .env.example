# s9 local development environment.
# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------- runtime
# Docker runtime for the API, worker and scheduler. Bun is the default;
# set both to run the images on Node.js instead.
# RUNTIME_IMAGE=oven/bun:1-alpine
# RUNTIME_BIN=bun
# RUNTIME_IMAGE=node:22-alpine
# RUNTIME_BIN=node

# ---------------------------------------------------------------- database
# Host port 55432 keeps the local stack independent from other projects.
DATABASE_URL=postgres://s9:s9@localhost:55432/s9

# ------------------------------------------------------------------- queue
REDIS_URL=redis://localhost:56379

# --------------------------------------------------------------------- api
API_PORT=4100
API_HOST=0.0.0.0
API_PUBLIC_URL=http://localhost:4100
WEB_PUBLIC_URL=http://localhost:3000

# Authentication is embedded in the API. `WEB_PUBLIC_URL` is also the
# Better-Auth origin: cookies and auth URLs are scoped to it.

# ---------------------------------------------------------------- secrets
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=nbBN+JawyUMjO7hX7yy5WsM2ipYbj+w8dCzmtK5zJ0w=
ENCRYPTION_KEY_ID=key-1

# Generate with: openssl rand -hex 32
SESSION_SECRET=3d069c5d44afa950b635f283a645bec55b2dd234ffdaa1c19db1da15b72c07b8

# ----------------------------------------------------------------- worker
WORKER_ID=worker-1
WORKER_CONCURRENCY=5

# ------------------------------------------------------------------ email
EMAIL_PROVIDER=mailpit
MAILPIT_URL=http://localhost:8025
# RESEND_API_KEY=

# ------------------------------------------------------------------ sinks
# Hostnames that may resolve to a private address (operator allowlist).
ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1,sink

# ------------------------------------------------------------------- seed
SEED_WORKSPACE_NAME="s9 Demo"
SEED_USER_EMAIL=operator@s9.local
SEED_USER_PASSWORD=s9-demo-password
SEED_USER_NAME="Demo Operator"
# The destination of the notification step in the demo workflow.
DEMO_NOTIFICATION_URL=http://localhost:8081/notify
