{
  "name": "@s9/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main-api.js",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "dev:api": "bun --watch src/main-api.ts",
    "dev:worker": "bun --watch src/main-worker.ts",
    "dev:scheduler": "bun --watch src/main-scheduler.ts",
    "start:api": "bun dist/main-api.js",
    "start:worker": "bun dist/main-worker.js",
    "start:scheduler": "bun dist/main-scheduler.js",
    "start:api:node": "node dist/main-api.js",
    "start:worker:node": "node dist/main-worker.js",
    "start:scheduler:node": "node dist/main-scheduler.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/cli/migrate.ts",
    "db:seed": "bun src/cli/seed.ts",
    "db:reset": "bun src/cli/reset.ts",
    "test": "bun test tests/unit && bun test --preload ./tests/setup/env.ts tests/integration",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test --preload ./tests/setup/env.ts tests/integration",
    "e2e:prepare": "bun tests/e2e/setup.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@s9/core": "workspace:*",
    "better-auth": "^1.7.18",
    "bullmq": "^5.62.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "ioredis": "^5.8.1",
    "pg": "^8.16.3",
    "pino": "^9.13.1",
    "undici": "^7.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.15.6",
    "bun-types": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "tsdown": "^0.23.7",
    "typescript": "^5.7.2"
  }
}
