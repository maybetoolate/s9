# End-to-end test environment.
#
# Playwright starts the API, the worker and the web app against these values.
# Everything here is disposable test infrastructure: the database and the
# Redis database are recreated on every `pnpm test:e2e` run, and the secrets
# are local-only placeholders that must never be reused in a deployment.
#
# The values are read by `packages/web/playwright.config.ts` and by
# `packages/server/tests/e2e/setup.ts`. Variables already present in the
# process environment win, so CI can point the suite at its own services.

# ---------------------------------------------------------------- database
# A dedicated database and Redis database (index 1) keep the suite away from
# the development stack, including its worker.
DATABASE_URL=postgres://s9:s9@localhost:55432/s9_e2e
DATABASE_ADMIN_URL=postgres://s9:s9@localhost:55432/postgres
REDIS_URL=redis://localhost:56379/1

# --------------------------------------------------------------------- api
LOG_LEVEL=warn
API_PORT=4200
API_HOST=127.0.0.1
API_PUBLIC_URL=http://localhost:4200

# --------------------------------------------------------------------- web
# The web dev server is started on this port; `WEB_PUBLIC_URL` is also the
# Better-Auth origin, so both must agree.
WEB_PORT=3100
WEB_PUBLIC_URL=http://localhost:3100

# ---------------------------------------------------------------- secrets
# Test-only placeholders. Generate real ones for a deployment.
ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
ENCRYPTION_KEY_ID=e2e-key
SESSION_SECRET=e2e-session-secret-at-least-32-characters-long

# ------------------------------------------------------------------ email
# The suite never executes an email step, so no mail catcher is required.
EMAIL_PROVIDER=mailpit
MAILPIT_URL=http://localhost:8025

ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------- seed
# The sign-in helper and the login screen both use these credentials.
SEED_WORKSPACE_NAME="s9 E2E"
SEED_USER_EMAIL=operator@s9.local
SEED_USER_PASSWORD=s9-demo-password
SEED_USER_NAME="E2E Operator"
DEMO_NOTIFICATION_URL=http://localhost:8081/notify
